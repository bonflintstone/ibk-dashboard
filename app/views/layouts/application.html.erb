<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ibk Dashboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="events around Innsbruck all in one place!">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= auto_discovery_link_tag :rss, feed_url, title: "Ibk Dashboard Events" %>
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= favicon_link_tag asset_path("favicon.png") %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <% if flash.any? %>
      <div class="container mx-auto mt-4 px-4">
        <div class="mx-auto flex w-full max-w-2xl flex-col gap-2">
          <% flash.each do |type, message| %>
            <div class="rounded-lg border px-4 py-2 text-sm <%= type.to_s == "alert" ? "border-red-300 bg-red-100 text-red-800" : "border-green-300 bg-green-100 text-green-800" %>"><%= message %></div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# pb keeps the last content clear of the fixed footer bar %>
    <main class="container mx-auto mt-4 flex px-4 pb-14">
      <%= yield %>
    </main>
    <footer class="fixed inset-x-0 bottom-0 z-20 border-t border-gray-200 bg-gray-50 py-2 text-sm text-gray-500">
      <%# mirrors the wrappers around the page content so the link aligns with it %>
      <div class="container mx-auto px-4">
        <div class="mx-auto flex w-full max-w-2xl justify-between">
          <span class="flex gap-3">
            <%= link_to "Impressum", imprint_path, class: "underline" %>
            <%= link_to "Datenschutz", privacy_path, class: "underline" %>
          </span>

          <span class="flex gap-3">
            <span data-controller="modal share-bookmarks">
              <button type="button" class="cursor-pointer underline" data-action="modal#open share-bookmarks#prepare">Gemerkte teilen</button>

              <div class="hidden fixed inset-0 z-30 bg-gray-900/50" data-modal-target="backdrop" data-action="click->modal#close"></div>
              <dialog class="fixed inset-0 z-40 m-auto h-fit max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-xl bg-white p-6 shadow-xl"
                      data-modal-target="dialog" data-action="keydown.esc@window->modal#close">
                <div class="flex items-center justify-between">
                  <h2 class="text-xl font-bold text-gray-900">Gemerkte Events teilen</h2>
                  <button type="button" class="cursor-pointer text-2xl leading-none text-gray-500" data-action="modal#close" aria-label="Schließen">&times;</button>
                </div>
                <p class="mt-3 text-sm text-gray-600">Öffne diesen Link auf einem anderen Gerät oder scanne den QR-Code dort — die gemerkten Events beider Geräte werden zusammengeführt und bleiben ab dann synchron.</p>
                <p class="hidden mt-3 text-sm text-red-700" data-share-bookmarks-target="error">Gerade nicht erreichbar — bitte später noch einmal versuchen.</p>
                <img class="mx-auto mt-4 h-44 w-44" alt="QR-Code zum Synchronisieren der gemerkten Events" data-share-bookmarks-target="qr">
                <p class="mt-4 break-all rounded-lg bg-gray-100 px-3 py-2 font-mono text-xs text-gray-700" data-share-bookmarks-target="link"></p>
                <button type="button" class="mt-3 w-full cursor-pointer rounded-lg bg-gray-900 px-4 py-2 font-medium text-white" data-share-bookmarks-target="copyButton" data-action="share-bookmarks#copy">Link kopieren</button>

                <hr class="mt-5 border-gray-200">
                <p class="mt-4 text-sm text-gray-600">Oder abonniere deine gemerkten Events als Kalender — sie erscheinen dann automatisch in Apple Kalender &amp; Co. und bleiben dort aktuell.</p>
                <a class="mt-3 block w-full rounded-lg bg-gray-900 px-4 py-2 text-center font-medium text-white" data-share-bookmarks-target="calendarLink" href="#">Kalender abonnieren</a>
                <button type="button" class="mt-2 w-full cursor-pointer rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700" data-share-bookmarks-target="copyCalendarButton" data-action="share-bookmarks#copyCalendar">Kalender-Link kopieren</button>
              </dialog>
            </span>

            <span data-controller="modal">
              <button type="button" class="cursor-pointer underline" data-action="modal#open">Event eintragen</button>

              <%# Opened non-modally (dialog.show()): showModal() would put the dialog
                  in the browser's top layer, which renders above the hCaptcha
                  challenge popup. With plain z-indexes the captcha stacks on top. %>
              <div class="hidden fixed inset-0 z-30 bg-gray-900/50" data-modal-target="backdrop" data-action="click->modal#close"></div>
              <dialog class="fixed inset-0 z-40 m-auto h-fit max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-xl bg-white p-6 shadow-xl"
                      data-modal-target="dialog" data-action="keydown.esc@window->modal#close">
                <div class="flex items-center justify-between">
                  <h2 class="text-xl font-bold text-gray-900">Neues Event</h2>
                  <button type="button" class="cursor-pointer text-2xl leading-none text-gray-500" data-action="modal#close" aria-label="Schließen">&times;</button>
                </div>
                <%= render "events/form", event: Event.new %>
              </dialog>
            </span>
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
