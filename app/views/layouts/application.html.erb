<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ibk Dashboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="events around Innsbruck all in one place!">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= auto_discovery_link_tag :rss, feed_url, title: "Ibk Dashboard Events" %>
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= favicon_link_tag asset_path("favicon.png") %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <%# pb keeps the last content clear of the fixed footer bar %>
    <main class="container mx-auto mt-4 flex px-4 pb-14">
      <%= yield %>
    </main>
    <footer class="fixed inset-x-0 bottom-0 z-20 border-t border-gray-200 bg-gray-50 py-2 text-sm text-gray-500">
      <%# mirrors the wrappers around the page content so the link aligns with it %>
      <div class="container mx-auto px-4">
        <div class="mx-auto w-full max-w-2xl">
          <%= link_to "Impressum", imprint_path, class: "underline" %>
        </div>
      </div>
    </footer>
  </body>
</html>
