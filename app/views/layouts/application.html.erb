<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ibk Dashboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="events around Innsbruck all in one place!">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= auto_discovery_link_tag :rss, feed_url, title: "Ibk Dashboard Events" %>
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= favicon_link_tag asset_path("favicon.png") %>
    <% if Hcaptcha.site_key.present? %>
      <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
    <% end %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <% if flash.any? %>
      <div class="container mx-auto mt-4 px-4">
        <div class="mx-auto flex w-full max-w-2xl flex-col gap-2">
          <% flash.each do |type, message| %>
            <div class="rounded-lg border px-4 py-2 text-sm <%= type.to_s == "alert" ? "border-red-300 bg-red-100 text-red-800" : "border-green-300 bg-green-100 text-green-800" %>"><%= message %></div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# pb keeps the last content clear of the fixed footer bar %>
    <main class="container mx-auto mt-4 flex px-4 pb-14">
      <%= yield %>
    </main>
    <footer class="fixed inset-x-0 bottom-0 z-20 border-t border-gray-200 bg-gray-50 py-2 text-sm text-gray-500">
      <%# mirrors the wrappers around the page content so the link aligns with it %>
      <div class="container mx-auto px-4">
        <div class="mx-auto flex w-full max-w-2xl justify-between" data-controller="modal">
          <%= link_to "Impressum", imprint_path, class: "underline" %>
          <button type="button" class="cursor-pointer underline" data-action="modal#open">Event eintragen</button>

          <%# Opened non-modally (dialog.show()): showModal() would put the dialog
              in the browser's top layer, which renders above the hCaptcha
              challenge popup. With plain z-indexes the captcha stacks on top. %>
          <div class="hidden fixed inset-0 z-30 bg-gray-900/50" data-modal-target="backdrop" data-action="click->modal#close"></div>
          <dialog class="fixed inset-0 z-40 m-auto h-fit max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-xl bg-white p-6 shadow-xl"
                  data-modal-target="dialog" data-action="keydown.esc@window->modal#close">
            <div class="flex items-center justify-between">
              <h2 class="text-xl font-bold text-gray-900">Neues Event</h2>
              <button type="button" class="cursor-pointer text-2xl leading-none text-gray-500" data-action="modal#close" aria-label="Schließen">&times;</button>
            </div>
            <%= render "events/form", event: Event.new %>
          </dialog>
        </div>
      </div>
    </footer>
  </body>
</html>
