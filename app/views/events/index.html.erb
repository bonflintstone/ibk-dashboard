<div class="w-full max-w-2xl mx-auto" data-controller="events" data-action="scroll@window->events#highlightCurrentDate">
  <h1 class="flex items-center gap-3 text-3xl font-bold tracking-tight">
    <%= image_tag "logo.png", alt: "", class: "h-9 w-auto" %>
    IBK Dashboard
  </h1>

  <% events_by_date = @events.group_by(&:date) %>
  <%# Chips reflect what is actually on the page: only categories and venues
      with upcoming events. Filtering is one-dimensional — by category, by
      venue, or by bookmarks ("Gemerkt", stored in the browser). %>
  <% categories = Event::CATEGORIES.select { |category| @events.any? { |event| event.display_category == category } } %>
  <% venues = @events.map(&:organization).uniq.sort %>
  <% chevron = capture do %>
    <svg class="h-3 w-3 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.23 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"/>
    </svg>
  <% end %>

  <div class="sticky top-0 z-10 -mx-4 bg-gray-50 px-4 pt-4" data-events-target="stickyHeader">
    <div class="flex items-center" data-events-target="navRow">
      <div class="inline-flex rounded-full border border-gray-300 bg-white p-0.5 text-sm font-medium">
        <button type="button" class="cursor-pointer rounded-full px-3 py-0.5" data-events-target="navButton" data-action="events#showAll" data-mode="all">Alle</button>
        <button type="button" class="flex cursor-pointer items-center gap-1 rounded-full px-3 py-0.5" data-events-target="navButton" data-action="events#togglePanel" data-mode="category" aria-expanded="false">Kategorie<%= chevron %></button>
        <button type="button" class="flex cursor-pointer items-center gap-1 rounded-full px-3 py-0.5" data-events-target="navButton" data-action="events#togglePanel" data-mode="venue" aria-expanded="false">Venue<%= chevron %></button>
        <button type="button" class="cursor-pointer rounded-full px-3 py-0.5" data-events-target="navButton" data-action="events#selectBookmarked" data-mode="bookmarked">Gemerkt</button>
      </div>
    </div>

    <%# Replaces the nav row while a filter is selected: back to "Alle" plus
        the active selection. The share button only accompanies "Gemerkt"
        (toggled in updateNav). %>
    <div class="hidden items-center gap-2" data-events-target="selectionBar">
      <button type="button" class="cursor-pointer p-1 text-gray-500" data-action="events#showAll" aria-label="Alle Events anzeigen">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
        </svg>
      </button>
      <span class="rounded-full bg-gray-900 px-3 py-1 text-sm font-medium text-white" data-events-target="selectionLabel"></span>

      <span class="hidden ml-auto" data-controller="modal share-bookmarks" data-events-target="shareButton">
        <button type="button" class="flex cursor-pointer items-center rounded-full border border-gray-300 bg-white p-1.5 text-gray-700" data-action="modal#open share-bookmarks#prepare" aria-label="Gemerkte teilen" title="Gemerkte teilen">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"/>
          </svg>
        </button>

        <div class="hidden fixed inset-0 z-30 bg-gray-900/50" data-modal-target="backdrop" data-action="click->modal#close"></div>
        <dialog class="fixed inset-0 z-40 m-auto h-fit max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-xl bg-white p-6 shadow-xl"
                data-modal-target="dialog" data-action="keydown.esc@window->modal#close">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-gray-900">Gemerkte Events teilen</h2>
            <button type="button" class="cursor-pointer text-2xl leading-none text-gray-500" data-action="modal#close" aria-label="Schließen">&times;</button>
          </div>
          <p class="mt-3 text-sm text-gray-600">Öffne diesen Link auf einem anderen Gerät oder scanne den QR-Code dort — die gemerkten Events beider Geräte werden zusammengeführt und bleiben ab dann synchron.</p>
          <p class="hidden mt-3 text-sm text-red-700" data-share-bookmarks-target="error">Gerade nicht erreichbar — bitte später noch einmal versuchen.</p>
          <img class="mx-auto mt-4 h-44 w-44" alt="QR-Code zum Synchronisieren der gemerkten Events" data-share-bookmarks-target="qr">
          <p class="mt-4 break-all rounded-lg bg-gray-100 px-3 py-2 font-mono text-xs text-gray-700" data-share-bookmarks-target="link"></p>
          <button type="button" class="mt-3 w-full cursor-pointer rounded-lg bg-gray-900 px-4 py-2 font-medium text-white" data-share-bookmarks-target="copyButton" data-action="share-bookmarks#copy">Link kopieren</button>

          <hr class="mt-5 border-gray-200">
          <p class="mt-4 text-sm text-gray-600">Oder abonniere deine gemerkten Events als Kalender — sie erscheinen dann automatisch in Apple Kalender &amp; Co. und bleiben dort aktuell.</p>
          <a class="mt-3 block w-full rounded-lg bg-gray-900 px-4 py-2 text-center font-medium text-white" data-share-bookmarks-target="calendarLink" href="#">Kalender abonnieren</a>
          <button type="button" class="mt-2 w-full cursor-pointer rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700" data-share-bookmarks-target="copyCalendarButton" data-action="share-bookmarks#copyCalendar">Kalender-Link kopieren</button>
        </dialog>
      </span>
    </div>

    <div class="mt-2 hidden flex-wrap gap-2" data-events-target="panel" data-mode="category">
      <% categories.each do |category| %>
        <button type="button" class="cursor-pointer rounded-full border border-gray-300 bg-white px-3 py-1 text-sm font-medium" data-action="events#selectChip" data-mode="category" data-value="<%= category %>"><%= category %></button>
      <% end %>
    </div>

    <div class="mt-2 hidden flex-wrap gap-2" data-events-target="panel" data-mode="venue">
      <% venues.each do |venue| %>
        <button type="button" class="flex cursor-pointer items-center gap-1.5 rounded-full border border-gray-300 bg-white px-3 py-1 text-sm" data-action="events#selectChip" data-mode="venue" data-value="<%= venue %>">
          <span class="inline-block h-2 w-2 rounded-full <%= organization_accent_color(venue) %>"></span><%= venue %>
        </button>
      <% end %>
    </div>

    <nav class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 py-3 mt-2">
      <% events_by_date.each_key do |date| %>
        <a href="#date-<%= date.iso8601 %>" class="flex shrink-0 flex-col items-center rounded-lg border border-gray-300 bg-white px-3 py-1 leading-tight" data-events-target="dateLink" data-action="events#selectDate">
          <span class="text-xs text-gray-500"><%= date == Date.today ? "Heute" : l(date, format: "%a") %></span>
          <span class="font-bold tabular-nums"><%= date.day %></span>
        </a>
      <% end %>
    </nav>
  </div>

  <% events_by_date.each do |date, events| %>
    <section id="date-<%= date.iso8601 %>" class="scroll-mt-(--filter-height,4rem)" data-events-target="dateGroup">
      <h3 class="pt-4 pb-2 text-sm font-semibold uppercase tracking-wide text-gray-500"><%= l(date, format: "%A %d. %B") %></h3>

      <% events.each do |event| %>
        <%= link_to event.link, target: "_blank", class: "block mb-3", data: { events_target: "event", organization: event.organization, category: event.display_category, bookmark_key: event.bookmark_key } do %>
          <div class="flex gap-3 rounded-xl bg-white p-4 shadow-sm transition-shadow hover:shadow-md">
            <div class="w-12 shrink-0 font-bold tabular-nums"><%= event.datetime.strftime("%H:%M") %></div>
            <div class="min-w-0 flex-1">
              <p class="flex items-center gap-2 text-sm text-gray-500">
                <span class="inline-block h-3.5 w-1 shrink-0 rounded <%= organization_accent_color(event.organization) %>"></span>
                <span class="truncate"><%= event.organization %><%= " · #{event.location}" if event.location != event.organization %></span>
              </p>
              <p class="mt-1 font-semibold"><%= event.name %></p>
              <% if event.description.present? %>
                <p class="mt-1 text-sm text-gray-500 line-clamp-2"><%= event.description %></p>
              <% end %>
            </div>
            <button type="button" class="-mt-1 -mr-1 h-fit shrink-0 cursor-pointer p-1 text-gray-300 hover:text-gray-500" data-events-target="bookmarkButton" data-action="events#toggleBookmark" aria-label="Event merken" aria-pressed="false">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c.94.13 1.657.954 1.657 1.902V21L12 17.25 4.75 21V5.224c0-.948.717-1.772 1.657-1.902a48.507 48.507 0 0 1 11.186 0Z"/>
              </svg>
            </button>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <p class="hidden mt-8 text-gray-500" data-events-target="emptyMessage">Keine Events für diese Auswahl.</p>
</div>
