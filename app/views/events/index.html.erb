<div class="w-full max-w-2xl mx-auto" data-controller="events" data-action="scroll@window->events#highlightCurrentDate">
  <h1 class="text-3xl font-bold tracking-tight">IBK Dashboard</h1>

  <% if @refetch_event %>
    <p class="mt-1 text-sm text-gray-500">
      Last updated: <%= @refetch_event.created_at.strftime("%d.%m.%Y %H:%M") %>
    </p>
  <% end %>

  <% events_by_date = @events.group_by(&:date) %>
  <%# Chips reflect what is actually on the page: only categories and venues
      with upcoming events. Filtering is one-dimensional — by category OR by
      venue, switched via the mode toggle. %>
  <% categories = Event::CATEGORIES.select { |category| @events.any? { |event| event.display_category == category } } %>
  <% venues = @events.map(&:organization).uniq.sort %>

  <div class="sticky top-0 z-10 -mx-4 bg-gray-50 px-4 pt-4" data-events-target="stickyHeader">
    <div class="flex items-center gap-2">
      <div class="inline-flex rounded-full border border-gray-300 bg-white p-0.5 text-sm font-medium">
        <button type="button" class="cursor-pointer rounded-full px-3 py-0.5" data-events-target="modeChip" data-action="events#selectMode" data-mode="all">Alle</button>
        <button type="button" class="cursor-pointer rounded-full px-3 py-0.5" data-events-target="modeChip" data-action="events#selectMode" data-mode="category">Nach Kategorie</button>
        <button type="button" class="cursor-pointer rounded-full px-3 py-0.5" data-events-target="modeChip" data-action="events#selectMode" data-mode="venue">Nach Venue</button>
      </div>

      <%# On mobile the chip row below is collapsed by default; this arrow
          expands it. Hidden on desktop, where the chips always show. %>
      <button type="button" class="cursor-pointer p-1 text-gray-500 sm:hidden" data-events-target="chipsArrow" data-action="events#toggleChips" aria-expanded="false" aria-label="Filter anzeigen">
        <svg class="h-4 w-4 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.23 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>

    <div class="hidden mt-2 flex-wrap gap-2" data-events-target="chipsRow">
      <div class="contents" data-events-target="panel" data-mode="category">
        <% categories.each do |category| %>
          <button type="button" class="cursor-pointer rounded-full border border-gray-300 bg-white px-3 py-1 text-sm font-medium" data-events-target="chip" data-action="events#selectChip" data-mode="category" data-value="<%= category %>"><%= category %></button>
        <% end %>
      </div>

      <div class="hidden contents" data-events-target="panel" data-mode="venue">
        <% venues.each do |venue| %>
          <button type="button" class="cursor-pointer flex items-center gap-1.5 rounded-full border border-gray-300 bg-white px-3 py-1 text-sm" data-events-target="chip" data-action="events#selectChip" data-mode="venue" data-value="<%= venue %>">
            <span class="inline-block h-2 w-2 rounded-full <%= organization_accent_color(venue) %>"></span><%= venue %>
          </button>
        <% end %>
      </div>
    </div>

    <nav class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 py-3 mt-2">
      <% events_by_date.each_key do |date| %>
        <a href="#date-<%= date.iso8601 %>" class="flex shrink-0 flex-col items-center rounded-lg border border-gray-300 bg-white px-3 py-1 leading-tight" data-events-target="dateLink" data-action="events#selectDate">
          <span class="text-xs text-gray-500"><%= date == Date.today ? "Heute" : l(date, format: "%a") %></span>
          <span class="font-bold tabular-nums"><%= date.day %></span>
        </a>
      <% end %>
    </nav>
  </div>

  <% events_by_date.each do |date, events| %>
    <section id="date-<%= date.iso8601 %>" class="scroll-mt-(--filter-height,4rem)" data-events-target="dateGroup">
      <h3 class="pt-4 pb-2 text-sm font-semibold uppercase tracking-wide text-gray-500"><%= l(date, format: "%A %d. %B") %></h3>

      <% events.each do |event| %>
        <%= link_to event.link, target: "_blank", class: "block mb-3", data: { events_target: "event", organization: event.organization, category: event.display_category } do %>
          <div class="flex gap-3 rounded-xl bg-white p-4 shadow-sm transition-shadow hover:shadow-md">
            <div class="w-12 shrink-0 font-bold tabular-nums"><%= event.datetime.strftime("%H:%M") %></div>
            <div class="min-w-0 flex-1">
              <p class="flex items-center gap-2 text-sm text-gray-500">
                <span class="inline-block h-3.5 w-1 shrink-0 rounded <%= organization_accent_color(event.organization) %>"></span>
                <span class="truncate"><%= event.organization %><%= " · #{event.location}" if event.location != event.organization %></span>
              </p>
              <p class="mt-1 font-semibold"><%= event.name %></p>
              <% if event.description.present? %>
                <p class="mt-1 text-sm text-gray-500 line-clamp-2"><%= event.description %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <p class="hidden mt-8 text-gray-500" data-events-target="emptyMessage">Keine Events für diese Auswahl.</p>
</div>
