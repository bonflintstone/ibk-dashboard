<div class="w-full" data-controller="events" data-events-default-selection-value="<%= Event::ORGANIZATIONS_BY_TYPE[:'Musik und Kultur'].to_json %>">
  <h1 class="text-3xl font-bold">IBK Dashboard</h1>

  <% if @refetch_event %>
    <p>
      Last updated:
      <span class="font-bold"><%= @refetch_event.created_at.strftime("%d.%m.%Y %H:%M:%S") %></span>
    </p>
  <% end %>

  <div class="flex flex-wrap mt-2">
    <button type="button" class="cursor-pointer rounded px-2 py-1 m-1 border font-bold" data-events-target="allChip" data-action="events#showAll">Alle</button>
    <% Event::ORGANIZATIONS_BY_TYPE.each do |type, organizations| %>
      <button type="button" class="cursor-pointer rounded px-2 py-1 m-1 border font-bold" data-events-target="categoryChip" data-action="events#selectCategory" data-organizations="<%= organizations.to_json %>"><%= type %></button>
    <% end %>
  </div>

  <button type="button" class="md:hidden cursor-pointer rounded px-2 py-1 m-1 border" data-action="events#toggleFilters">
    Filter <span data-events-target="filterCount"></span>
  </button>

  <div class="hidden md:block" data-events-target="filterPanel">
    <div class="flex flex-wrap">
      <% Event::ORGANIZATIONS.each do |organization| %>
        <button type="button" class="cursor-pointer rounded px-2 py-1 m-1 border <%= organization_color(organization) %>" data-events-target="chip" data-action="events#toggleOrganization" data-organization="<%= organization %>"><%= organization %></button>
      <% end %>
    </div>
  </div>

  <% events_by_date = @events.group_by(&:date) %>

  <nav class="sticky top-0 z-10 bg-white flex overflow-x-auto whitespace-nowrap py-2 mt-2 border-b">
    <% events_by_date.each_key do |date| %>
      <a href="#date-<%= date.iso8601 %>" class="rounded px-2 py-1 mx-1 border shrink-0" data-events-target="dateLink">
        <%= date == Date.today ? "Heute" : l(date, format: "%a %d.%m.") %>
      </a>
    <% end %>
  </nav>

  <% events_by_date.each do |date, events| %>
    <section id="date-<%= date.iso8601 %>" class="scroll-mt-14" data-events-target="dateGroup">
      <h3 class="text-xl font-bold p-3 mt-4 sticky top-12 bg-white"><%= l(date, format: "%A %d.%m.%Y") %></h3>

      <% events.each do |event| %>
        <%= link_to event.link, target: "_blank", class: "block", data: { events_target: "event", organization: event.organization } do %>
          <div class="py-2 px-1 my-2 border">
            <p class="pl-2 py-1 <%= organization_color(event.organization) %>">
            <%= event.datetime.strftime("%H:%M") %>
            <span class="font-bold"><%= event.location != event.organization ? "#{event.organization}," : "" %></span>
            <span class="font-bold"><%= event.location %></span>
            </p>
            <p class="pl-1 mt-1 font-bold"><%= event.name %></p>
            <p class="pl-1 mt-1"><%= event.description.to_s.truncate_words(20, omission: "...") %></p>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <p class="hidden mt-8" data-events-target="emptyMessage">Keine Events für diese Auswahl.</p>
</div>
