<div class="w-full max-w-2xl mx-auto" data-controller="events" data-events-default-selection-value="<%= Event.organizations_by_type[:'Musik und Kultur'].to_json %>">
  <h1 class="text-3xl font-bold tracking-tight">IBK Dashboard</h1>

  <% if @refetch_event %>
    <p class="mt-1 text-sm text-gray-500">
      Last updated: <%= @refetch_event.created_at.strftime("%d.%m.%Y %H:%M") %>
    </p>
  <% end %>

  <% events_by_date = @events.group_by(&:date) %>

  <div class="sticky top-0 z-10 -mx-4 bg-gray-50 px-4 pt-4" data-events-target="stickyHeader">
    <div class="flex flex-wrap gap-2">
      <button type="button" class="cursor-pointer rounded-full border border-gray-300 bg-white px-3 py-1 text-sm font-medium" data-events-target="allChip" data-action="events#showAll">Alle</button>
      <% Event.organizations_by_type.each do |type, organizations| %>
        <button type="button" class="cursor-pointer rounded-full border border-gray-300 bg-white px-3 py-1 text-sm font-medium" data-events-target="categoryChip" data-action="events#selectCategory" data-category="<%= type %>" data-organizations="<%= organizations.to_json %>"><%= type %></button>
      <% end %>
    </div>

    <div class="hidden mt-2 flex flex-wrap gap-2" data-events-target="venuePanel">
      <% Event.organizations_by_type.each do |type, organizations| %>
        <% organizations.each do |organization| %>
          <button type="button" class="hidden cursor-pointer flex items-center gap-1.5 rounded-full border border-gray-300 bg-white px-3 py-1 text-sm" data-events-target="chip" data-action="events#toggleOrganization" data-organization="<%= organization %>" data-category="<%= type %>">
            <span class="inline-block h-2 w-2 rounded-full <%= organization_accent_color(organization) %>"></span><%= organization %>
          </button>
        <% end %>
      <% end %>
    </div>

    <nav class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 py-3 mt-2">
      <% events_by_date.each_key do |date| %>
        <a href="#date-<%= date.iso8601 %>" class="flex shrink-0 flex-col items-center rounded-lg border border-gray-300 bg-white px-3 py-1 leading-tight" data-events-target="dateLink">
          <span class="text-xs text-gray-500"><%= date == Date.today ? "Heute" : l(date, format: "%a") %></span>
          <span class="font-bold tabular-nums"><%= date.day %></span>
        </a>
      <% end %>
    </nav>
  </div>

  <% events_by_date.each do |date, events| %>
    <section id="date-<%= date.iso8601 %>" class="scroll-mt-(--filter-height,4rem)" data-events-target="dateGroup">
      <h3 class="sticky top-(--filter-height,3.5rem) bg-gray-50 pt-4 pb-2 text-sm font-semibold uppercase tracking-wide text-gray-500"><%= l(date, format: "%A %d. %B") %></h3>

      <% events.each do |event| %>
        <%= link_to event.link, target: "_blank", class: "block mb-3", data: { events_target: "event", organization: event.organization } do %>
          <div class="flex gap-3 rounded-xl bg-white p-4 shadow-sm transition-shadow hover:shadow-md">
            <div class="w-12 shrink-0 font-bold tabular-nums"><%= event.datetime.strftime("%H:%M") %></div>
            <div class="min-w-0 flex-1">
              <p class="flex items-center gap-2 text-sm text-gray-500">
                <span class="inline-block h-3.5 w-1 shrink-0 rounded <%= organization_accent_color(event.organization) %>"></span>
                <span class="truncate"><%= event.organization %><%= " · #{event.location}" if event.location != event.organization %></span>
              </p>
              <p class="mt-1 font-semibold"><%= event.name %></p>
              <% if event.description.present? %>
                <p class="mt-1 text-sm text-gray-500 line-clamp-2"><%= event.description %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <p class="hidden mt-8 text-gray-500" data-events-target="emptyMessage">Keine Events für diese Auswahl.</p>
</div>
